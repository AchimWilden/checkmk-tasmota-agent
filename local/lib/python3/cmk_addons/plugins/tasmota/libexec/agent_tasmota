#!/usr/bin/env python3

import argparse
import json
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


def device_url(address, port):
    host = f"[{address}]" if ":" in address and not address.startswith("[") else address
    return f"http://{host}:{port}/cm?cmnd=Status%200"


def fetch_status(address, port, timeout):
    host = f"[{address}]" if ":" in address and not address.startswith("[") else address
    url = device_url(address, port)
    request = Request(
        url,
        headers={
            "Accept": "application/json",
            "Referer": f"http://{host}:{port}/",
        },
    )
    with urlopen(request, timeout=timeout) as response:
        payload = json.loads(response.read().decode("utf-8"))
    if not isinstance(payload, dict):
        raise ValueError("Tasmota returned a non-object JSON response")
    return payload


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--address", required=True)
    parser.add_argument("--port", type=int, default=80)
    parser.add_argument("--timeout", type=float, default=5.0)
    args = parser.parse_args()

    try:
        payload = fetch_status(args.address, args.port, args.timeout)
    except (HTTPError, URLError, OSError, TimeoutError, ValueError) as exc:
        detail = str(exc).replace("\r", " ").replace("\n", " ")[:300]
        payload = {"error": detail or type(exc).__name__}

    print("<<<tasmota:sep(0)>>>")
    print(json.dumps(payload, separators=(",", ":"), ensure_ascii=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())